{
  "name": "datalytics-server",
  "version": "1.0.0",
  "description": "Datalytics Node.js/Express backend.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo \"No build step required for plain Node.js/Express\" && exit 0",
    "ml:install": "python -m pip install -r ml-service/requirements.txt",
    "ml:dev": "python -m uvicorn app.main:app --app-dir ml-service --reload --port 8001",
    "ml:start": "python -m uvicorn app.main:app --app-dir ml-service --host 127.0.0.1 --port 8001"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "mongoose": "^9.9.4",
    "multer": "^2.2.0",
    "mysql2": "^3.23.4",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
